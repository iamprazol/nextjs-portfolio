# Copy to .env.local and fill in. Parsed and validated by src/env.ts (server-only).

# GitHub username whose work the site shows. Required.
GITHUB_LOGIN=

# Fine-grained PAT, read-only: Contents, Metadata, Pull requests.
# Required for production builds; optional locally when GITHUB_MOCK=1.
GITHUB_TOKEN=

# "owner/name" of the repo holding the portfolio/ content folder.
# Defaults to iamprazol/iamprazol.
GITHUB_CONTENT_REPO=

# Comma-separated owners searched for the portfolio-system topic, e.g. "iamprazol,themegrill".
# Defaults to GITHUB_LOGIN.
GITHUB_SYSTEM_OWNERS=

# HMAC secret for the GitHub webhook that calls /api/revalidate.
GITHUB_WEBHOOK_SECRET=

# Bearer token Vercel cron sends to /api/revalidate?all=1.
CRON_SECRET=

# 1 = serve fixtures instead of calling GitHub. Dev and tests only; rejected in production deploys.
GITHUB_MOCK=

# API key for the contact form (wpmake Everest Forms).
WP_API_KEY=
